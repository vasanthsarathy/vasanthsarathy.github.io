{
  "name": "vsarathy-personal-site",
  "version": "2.0.0",
  "description": "Personal website of Vasanth Sarathy - Research Assistant Professor at Tufts University",
  "scripts": {
    "start": "eleventy --serve --port=4000",
    "build": "cross-env NODE_ENV=production eleventy",
    "debug": "cross-env DEBUG=Eleventy* eleventy",
    "stop": "node scripts/kill-port.js"
  },
  "keywords": [
    "eleventy",
    "static-site",
    "personal-website"
  ],
  "author": "Vasanth Sarathy",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-img": "^4.0.2",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "bibtex-parse-js": "^0.0.24",
    "cross-env": "^7.0.3",
    "katex": "^0.16.9",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-attrs": "^4.1.6"
  },
  "dependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0"
  }
}
