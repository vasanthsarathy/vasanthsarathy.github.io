---
layout: layouts/page.njk
title: Publications
description: Research publications by Vasanth Sarathy
permalink: /publications/
---

<p>My research publications on AI, NLP, and socially-competent systems.</p>

<div class="publications">
  {% for year in publications.years %}
  <div class="year-group">
    <h2 class="year-heading">{{ year }}</h2>

    {% for pub in publications.byYear[year] %}
    <div class="publication">
      <div class="publication-title">
        {{ pub.title }}
      </div>

      <div class="publication-authors">
        {{ pub.author }}
      </div>

      {% if pub.booktitle %}
      <div class="publication-venue">
        {% if pub.abbr %}<strong>{{ pub.abbr }}</strong> - {% endif %}{{ pub.booktitle }}{% if pub.year %}, {{ pub.year }}{% endif %}
      </div>
      {% endif %}

      {% if pub.publisher %}
      <div class="publication-publisher">
        {{ pub.publisher }}
      </div>
      {% endif %}

      <div class="publication-links">
        {% if pub.abstract %}
        <details>
          <summary>Abstract</summary>
          <p>{{ pub.abstract }}</p>
        </details>
        {% endif %}

        {% if pub.arxiv %}
        <a href="https://arxiv.org/abs/{{ pub.arxiv }}" target="_blank">arXiv</a>
        {% endif %}

        {% if pub.pdf %}
        <a href="/assets/pdf/{{ pub.pdf }}" target="_blank">PDF</a>
        {% endif %}

        {% if pub.poster %}
        <a href="/assets/pdf/{{ pub.poster }}" target="_blank">Poster</a>
        {% endif %}

        {% if pub.supp %}
        <a href="{{ pub.supp }}" target="_blank">Supplementary</a>
        {% endif %}

        {% if pub.code %}
        <a href="{{ pub.code }}" target="_blank">Code</a>
        {% endif %}

        {% if pub.website %}
        <a href="{{ pub.website }}" target="_blank">Website</a>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
