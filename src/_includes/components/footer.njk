<footer class="site-footer">
  <p class="footer-name">&copy; {{ site.name }} {{ page.date.getFullYear() if page.date else "now" | date("YYYY") }}</p>
  <p class="footer-links">
    <a href="mailto:{{ site.email }}">Email</a>
    <a href="https://scholar.google.com/citations?user={{ site.scholar }}">Scholar</a>
    <a href="https://github.com/{{ site.github }}">GitHub</a>
    <a href="https://linkedin.com/in/{{ site.linkedin }}">LinkedIn</a>
    <a href="/feed.xml">RSS</a>
  </p>
</footer>
