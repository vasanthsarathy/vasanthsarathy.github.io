---
layout: layouts/base.njk
---

<div class="hero hero-solo">
  <div class="hero-text">
    <p class="eyebrow">
      <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
      {% if tags %}&middot; {{ tags | join(", ") }}{% endif %}
    </p>

    <h1>{{ title }}</h1>

    {% if description %}
    <p class="banner-question">{{ description }}</p>
    {% endif %}
  </div>
</div>

<article class="post-body">
  {{ content | safe }}
</article>

<p class="more-link"><a href="/blog/">&larr; All posts</a></p>
